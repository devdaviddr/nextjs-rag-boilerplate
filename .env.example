# ---------------------------------------------------------------------------
# Copy to `.env` for local development:  cp .env.example .env
# NEVER commit a real .env file. Generate secrets, don't reuse these samples.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Matches the credentials in docker-compose.yml for local dev.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?sslmode=disable"

# --- File storage (S3-compatible — MinIO by default) ------------------------
# Matches the `minio` service in docker-compose.yml for local dev — start it
# with `pnpm docker:minio`. MinIO stays internal-only in production (see
# docker-compose.prod.yml); the app is the only public gateway to it.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_BUCKET="app-files"
# S3_REGION="us-east-1"

# Upload limits (optional — shown defaults). Comma-separated MIME allow-list.
# UPLOAD_MAX_SIZE_MB="10"
# MAX_STORAGE_PER_USER_MB="500"
# UPLOAD_ALLOWED_MIME_TYPES="image/png,image/jpeg,image/webp,image/gif,application/pdf"

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Generate a strong secret:  openssl rand -base64 33   (or: npx auth secret)
AUTH_SECRET="replace-me-with-a-long-random-string"

# Canonical URL of the app. Required in production; optional locally.
# AUTH_URL="http://localhost:3000"

# Trust the host header (needed behind proxies / in Docker). Keep true in prod
# only when you terminate TLS at a trusted proxy.
AUTH_TRUST_HOST="true"

# OAuth providers (optional). Each is enabled only when BOTH its id and secret
# are set; leave unset for credentials-only auth. Callback URLs to register:
#   GitHub → {APP_URL}/api/auth/callback/github
#   Google → {APP_URL}/api/auth/callback/google
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Public origin of this deployment. Used for OpenGraph/Twitter share-card image
# URLs (metadataBase) and the robots/sitemap routes. Optional locally (defaults
# to http://localhost:3000); set to the real domain per fork for correct cards.
# APP_URL="https://example.com"

# Require users to verify their email before admin actions are allowed (a soft
# gate — a banner + blocked admin mutations, not a full lockout). Only takes
# effect when email is enabled. Off by default.
# REQUIRE_EMAIL_VERIFICATION="false"

# Web Push (optional). Generate a keypair:  npx web-push generate-vapid-keys
# The notifications toggle stays hidden until all three are set. VAPID_SUBJECT
# is a contact URL (usually mailto:). The private key is server-only.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# --- Backups (production compose only — see docs/backups.md) -----------------
# Used by the db-backup / minio-backup services in docker-compose.prod.yml.
# BACKUP_RETENTION_DAYS="14"        # daily Postgres dumps to keep
# BACKUP_INTERVAL_SECONDS="86400"   # MinIO mirror cadence
# Optional offsite copy (disk-failure resilience) — off unless all are set:
# OFFSITE_BACKUP_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# OFFSITE_BACKUP_ACCESS_KEY=""
# OFFSITE_BACKUP_SECRET_KEY=""
# OFFSITE_BACKUP_BUCKET=""

# --- Runtime ----------------------------------------------------------------
NODE_ENV="development"

# Log verbosity: debug | info | warn | error (defaults to debug / info in prod).
# LOG_LEVEL="info"

# Set to "true" to disable the in-memory auth rate limiter (e.g. some test runs).
# RATE_LIMIT_DISABLED="false"

# --- Email (optional, OFF by default) ---------------------------------------
# All email features (e.g. invite delivery) are disabled unless EMAIL_ENABLED
# is "true" AND an SMTP provider is configured below. If you set EMAIL_ENABLED
# without EMAIL_FROM + SMTP_HOST + SMTP_PORT, the app fails fast at boot.
# SMTP is provider-agnostic — Resend, SendGrid, Mailgun, SES, Postmark and Gmail
# all expose SMTP credentials.
# EMAIL_ENABLED="false"
# EMAIL_FROM="no-reply@example.com"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"                # 587 (STARTTLS) or 465 (implicit TLS)
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_SECURE="false"            # force implicit TLS; auto-true when port is 465

# --- Cloudflare Tunnel deployment (optional) --------------------------------
# See docs/deployment.md. Runtime only needs the tunnel token; provisioning
# vars are only used by Terraform (`make tunnel-provision`).

# Runtime — the cloudflared daemon's run token (from `make tunnel-provision`).
# CLOUDFLARE_TUNNEL_TOKEN=""
# Public URL of the app behind the named tunnel (required for tunnel mode).
# AUTH_URL="https://app.example.com"

# Provisioning-only (Terraform) — scoped token: Account>Tunnel:Edit, Zone>DNS:Edit.
# Prefer infra/cloudflare/terraform.tfvars over env for these.
# CLOUDFLARE_API_TOKEN=""
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ZONE_ID=""
# TUNNEL_HOSTNAME="app.example.com"

# --- Continuous deployment (optional — see docs/self-hosting.md) -------------
# Pull a pre-built image published to GHCR by CI instead of building on the box
# (used by docker-compose.deploy.yml / `make deploy`). Lower-case owner/repo.
# APP_IMAGE="ghcr.io/your-org/nextjs-fullstack-boilerplate"
# APP_TAG="latest"                  # or a pinned release, e.g. 0.15.0 (no "v" — semver image tags are unprefixed)

# APP_GIT_SHA is baked into the image by CI (Docker build-arg) and shown in
# Settings → Build. APP_VERSION is applied at RUNTIME from APP_TAG (see
# docker-compose.deploy.yml) because a release tag re-tags main's image rather
# than rebuilding it (spec 0024) — so the pinned APP_TAG is what Settings shows.
# Setting these by hand only matters for a locally-built image.

# Encrypts API keys saved from Settings → AI provider (spec 0040). Optional:
# derived from AUTH_SECRET when unset. Changing it (or AUTH_SECRET, when this
# is unset) makes saved keys unreadable; Settings then asks for them again.
# SETTINGS_ENCRYPTION_KEY=
# Make Settings → Configuration read-only, for deployments that keep AI config
# in .env. Saved values still apply; nothing can be changed from the page.
# AI_SETTINGS_LOCKED=true

# --- RAG / document chat (spec 0025) -----------------------------------------
# A free NVIDIA NIM key: https://build.nvidia.com  (rate-limited, not billed).
# Leave unset to run the app without the knowledge-base and chat features.
NVIDIA_API_KEY=
# Any OpenAI-compatible endpoint. Point it at Ollama or llama.cpp for a fully
# offline deployment, e.g. http://host.docker.internal:11434/v1
RAG_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Fixed at 2048 dimensions — changing the model needs a schema migration.
RAG_EMBED_MODEL=nvidia/nemotron-3-embed-1b
RAG_CHAT_MODEL=nvidia/nemotron-3-super-120b-a12b
RAG_CHUNK_TOKENS=512
RAG_CHUNK_OVERLAP_TOKENS=64
RAG_EMBED_BATCH=32
RAG_EMBED_CONCURRENCY=4
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35
RAG_MIN_CHARS_PER_PAGE=50
RAG_MAX_DOCUMENT_PAGES=200
RAG_DOC_SCOPE_MAX_CHUNKS=24
RAG_HYBRID_CANDIDATES=20
RAG_RRF_K=60

# --- Document cracking (spec 0031) -------------------------------------------
# Tables, figures and complex layouts. Off by default: with this false,
# ingestion behaves exactly as before and spends no extra API calls.
# Pages with a usable text layer NEVER cost a call even when this is on — only
# multi-column, tabular, image-heavy and scanned pages are routed to the parser.
RAG_CRACK_ENABLED=false
RAG_PARSE_MODEL=nvidia/nemotron-parse
RAG_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# Parse calls one document may spend. Past the cap the remaining pages fall
# back to the text layer and the document still finishes as `ready`.
RAG_CRACK_MAX_PAGES=25
RAG_CRACK_RENDER_SCALE=2.0
# Below this share of the page a Picture is decoration, not a figure.
RAG_CRACK_MIN_FIGURE_AREA=0.02
# Vision calls per document, for figures with no caption to use instead.
# ~40s each, so this is the tightest budget in the system.
RAG_DESCRIBE_MAX_FIGURES=8
# Answer-time figure reading, as a tool on the agentic loop. Needs both this
# and RAG_CRACK_ENABLED — without cracking, no chunk is ever a figure.
RAG_READ_FIGURE_ENABLED=false
# NOTE: one read_figure costs ~13.5s AND ~6,600 tokens, so with the tool on both
# loop budgets are raised to floors (45s, 30k tokens) regardless of the values
# below — a vision call blows through the text-sized defaults of 15s and 8k, and
# the loop stops holding a correct reading it never gets to use.

# --- Agentic retrieval (spec 0029) -------------------------------------------
# ON by default since 2026-09-11, on measurement: over 16 answerable follow-up
# questions the fixed pipeline scored hit@1 0.062 against the loop's 0.938. It
# embeds the question literally, so a pronoun retrieves nothing.
# The cost: ~11s per question against ~0.15s, and single-hop hit@1 0.882 ->
# 0.824. Set to false if your users only ever ask standalone questions.
RAG_AGENTIC_ENABLED=true
# Planning and prose are separate roles. Measured over 40 native tool-call
# attempts: lightning 10/10 and 5/5 on a two-round tool loop; the default chat
# model 8/10, its failures clean transport 500s the retry wrapper already
# absorbs. Prose quality was NOT measured — hence two settings, not one.
RAG_PLANNER_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# `off` skips the planner's hidden reasoning before each decision: much
# faster, for models that honour chat_template_kwargs.enable_thinking
# (Nemotron, Qwen3 on NIM / vLLM). See #84 for the measurement.
# RAG_PLANNER_REASONING=on
# Spec 0043: plan only when it pays. `adaptive` sends only follow-ups and
# multi-part questions to the planner; `always` plans every question.
# RAG_AGENTIC_ROUTE=always
# A first search whose best match reaches this ends the loop without a second
# planner decision. 1 turns it off.
# RAG_AGENTIC_CONFIDENT_SIMILARITY=1
# Most any one planner call may take, in ms. 0 = no cap beyond RAG_MAX_LOOP_MS.
# RAG_PLANNER_CALL_MS=0
# Hard caps. An unbounded loop against a rate-limited free tier is a
# denial-of-service against yourself.
RAG_MAX_SEARCHES=3
# The similarity floor rises by this much per EXTRA search. N attempts get N
# chances to clear a fixed floor by luck: without this, refusal accuracy fell
# from 1.000 to 0.667 while every other metric improved. Raising the flat floor
# instead does not work — true positives score 0.41-0.62, so any floor above the
# offending 0.421 discards real answers.
RAG_AGENTIC_FLOOR_STEP=0.04
RAG_MAX_LOOP_MS=15000
RAG_MAX_LOOP_TOKENS=8000

# --- Reranking (spec 0036) ---------------------------------------------------
# Off by default. With this false the fused order is returned untouched and no
# extra call is made. On, the top RAG_RERANK_CANDIDATES fused candidates are
# re-scored by RAG_RERANK_BACKEND and reordered.
#
# The rerank step itself only permutes: nothing is added, removed or truncated,
# so the similarity gate admits exactly the same chunks from whatever pool it is
# shown. A backend that errors, times out or returns junk leaves fusion order
# untouched.
#
# Turning this on DOES widen the retrieved pool, though (see below), and a wider
# pool can let a chunk fusion ranked 12th reach an answer that today refuses.
# Re-measure refusal accuracy before enabling.
RAG_RERANK_ENABLED=false
# How many fused candidates are retrieved and re-scored, from the top.
#
# This sizes the POOL, it is not a window over an already-cut list: with
# reranking on, retrieval fuses, keeps this many, reranks, gates on similarity
# and only then cuts to RAG_TOP_K. Above RAG_TOP_K (8) is the point — at 20 the
# reranker can promote a chunk fusion ranked 9th into the answer, which is the
# only thing reranking is for. Values below RAG_TOP_K are raised to it.
RAG_RERANK_CANDIDATES=20
# Which backend scores them. `local` runs a small cross-encoder in-process on
# the native ONNX runtime: no account, no text leaves the box, one-time model
# download. Measured: hit@1 0.882 -> 0.941 with refusal held at 1.000; about
# 0.65s for 20 passages at two threads on 2 vCPU (#38). `llm` scores with
# RAG_PLANNER_MODEL over the NIM account instead.
RAG_RERANK_BACKEND=local
# The local backend's model (a Hugging Face id with an ONNX export) and where
# its weights are cached. The default model is 23 MB and English-only;
# Xenova/bge-reranker-base is multilingual and 279 MB.
RAG_RERANK_LOCAL_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RAG_RERANK_MODEL_DIR=.cache/rerank-models
# CPU threads for the local reranker (1-16). On 2 vCPU: 1 thread 1.3s, 2
# threads 0.65s, 4 threads 0.97s — more threads than cores is slower, and each
# one is taken from request handling.
RAG_RERANK_THREADS=2

# Parent-child assembly (spec 0033, 1c). After the similarity gate, when two or
# more admitted chunks belong to one section run on one page (same heading, same
# heading position), they are replaced by the whole run as one source. Nothing
# extra is embedded or stored, so the gate still decides what is relevant and a
# refusal stays a refusal. The parent is capped at 3 x RAG_CHUNK_TOKENS; a longer
# run stays as separate chunks. No re-ingest needed.
RAG_PARENT_ASSEMBLY=true

# --- Observability (spec 0042) ------------------------------------------------
# Log lines are also kept in Postgres for Observability → Logs (admins only).
# LOG_PERSIST=false turns that off; stdout logging is unaffected.
# LOG_PERSIST=true
# LOG_RETENTION_DAYS=7
# Runs (every question and ingestion, step by step) for Observability.
# TELEMETRY_RETENTION_DAYS=30
