# dependencies
/node_modules
.pnp
.pnp.*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# testing
/coverage
/playwright-report
/test-results
/blob-report
/playwright/.cache

# env files — never commit real secrets
.env
.env*.local
.env.production

# local compose overrides — per-machine ports and env wiring, not the stack
docker-compose.local.yml

# drizzle
/drizzle/meta/_journal.json.bak

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.idea
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# turbo / caches
.turbo
*.tsbuildinfo

# terraform (state holds secrets; lockfile IS committed)
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
*.tfvars
!*.tfvars.example

# graphify generated knowledge graph (regenerated by the post-commit hook)
graphify-out/

# Local backups — contain full user data (emails, password hashes, files).
# Never commit; keep host directory permissions tight (see docs/backups.md).
backups/
eval/results/

# Agent worktrees (created by Claude Code, never part of the repo).
.claude/worktrees/
